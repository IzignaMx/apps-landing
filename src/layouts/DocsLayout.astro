---
import '../styles/global.css';
import { type Locale, getLocaleFromUrl, getTranslations, getAlternateUrl, localePath, getAppTranslation } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocSearch from '../components/DocSearch.astro';
import { getAppByKey } from '../data/apps';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  breadcrumbs?: { label: string; href?: string }[];
  /** Current app key — drives the sidebar navigation. */
  appKey?: string;
}

const { title, description, breadcrumbs, appKey = 'omnisync' } = Astro.props;
const url = Astro.url;
const locale = Astro.props.locale || getLocaleFromUrl(url);
const t = getTranslations(locale);
const canonicalUrl = new URL(url.pathname, url.origin).href;
const enUrl = locale === 'en' ? canonicalUrl : new URL(getAlternateUrl(url, 'en'), url.origin).href;
const esUrl = locale === 'es' ? canonicalUrl : new URL(getAlternateUrl(url, 'es'), url.origin).href;

const appMeta = getAppByKey(appKey);
const appDisplayName =
  getAppTranslation(t, appMeta?.translationKey ?? appKey)?.name ??
  appMeta?.key ??
  appKey;

const sectionKeys = ['getting-started', 'api', 'pricing', 'faq', 'changelog', 'guides'] as const;
const sections = sectionKeys.map((key) => ({
  key,
  label: t.docs.sections[key],
  href: localePath(`${appMeta?.docsBasePath ?? `/docs/${appKey}`}/${key}`, locale),
}));

const currentPath = url.pathname;
const docsHomeHref = localePath('/docs', locale);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0f0f" />
    <meta name="robots" content="index, follow" />
    <title>{title} — IzignaMx Docs</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/images/isotipo.png" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preload" href="/fonts/adam-cg-pro.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og-image.svg', url.origin).href} />
    <meta property="og:site_name" content="IzignaMx Apps" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_MX'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.svg', url.origin).href} />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="f2cc181d-e213-4fe8-a604-b178d259d212"></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": title,
      "description": description,
      "url": canonicalUrl,
      "publisher": {
        "@type": "Organization",
        "name": "IzignaMx",
        "url": "https://izignamx.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://apps.izignamx.com/images/isotipo.png"
        }
      }
    })} />
  </head>
  <body class="min-h-screen bg-bg text-text-primary antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-4 focus:left-4 focus:bg-izigna focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} />
    <div class="max-w-[1280px] mx-auto px-6 flex gap-8">
      <aside class="hidden lg:block w-56 shrink-0 py-8 sticky top-20 h-[calc(100vh-5rem)] overflow-y-auto border-r border-border-card pr-6">
        <div class="mb-6">
          <a href={docsHomeHref} class="font-display text-sm font-bold text-text-primary hover:text-izigna transition-colors">
            Docs
          </a>
          <span class="text-text-muted mx-1">/</span>
          <span class="text-xs font-mono text-izigna">{appDisplayName}</span>
        </div>
        <nav aria-label="Documentation">
          <ul class="space-y-1">
            {sections.map((section) => (
              <li>
                <a
                  href={section.href}
                  aria-current={currentPath === section.href ? 'page' : undefined}
                  class:list={[
                    'block text-sm px-3 py-1.5 rounded-md transition-colors duration-200',
                    currentPath === section.href
                      ? 'bg-izigna/10 text-izigna font-semibold'
                      : 'text-text-muted hover:text-text-primary hover:bg-card',
                  ]}
                >
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
      <main id="main" class="flex-1 min-w-0 py-8">
        <div class="lg:hidden mb-6">
          <details class="border border-border-card rounded-lg bg-card">
            <summary class="px-4 py-3 text-sm font-semibold cursor-pointer flex items-center justify-between">
              {t.docs.navigation}
              <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <nav class="px-4 pb-3" aria-label="Mobile docs navigation">
              <ul class="space-y-1">
                {sections.map((section) => (
                  <li>
                    <a
                      href={section.href}
                      aria-current={currentPath === section.href ? 'page' : undefined}
                      class:list={[
                        'block text-sm px-3 py-1.5 rounded-md transition-colors',
                        currentPath === section.href
                          ? 'bg-izigna/10 text-izigna font-semibold'
                          : 'text-text-muted hover:text-text-primary',
                      ]}
                    >
                      {section.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
        <DocSearch locale={locale} />
        {breadcrumbs && (
          <nav class="not-prose mb-4" aria-label="Breadcrumb">
            <ol class="flex items-center gap-1.5 text-xs text-text-muted">
              {breadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-1.5">
                  {i > 0 && <span aria-hidden="true">/</span>}
                  {crumb.href ? (
                    <a href={crumb.href} class="hover:text-izigna transition-colors">{crumb.label}</a>
                  ) : (
                    <span class="text-text-primary font-medium">{crumb.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}
        <article class="prose-docs max-w-3xl" data-pagefind-body data-pagefind-lang={locale}>
          <slot />
        </article>
      </main>
    </div>
    <Footer locale={locale} />
    <script is:inline data-locale={locale}>
      (function(){
        if (location.search.indexOf('lang=es') !== -1) { location.replace('/es' + location.pathname); return; }
        if (location.search.indexOf('lang=en') !== -1) { location.replace(location.pathname); return; }
        var loc = document.currentScript.getAttribute('data-locale');
        var stored;
        try { stored = localStorage.getItem('izigna-locale'); } catch(e){}
        if (stored !== loc) { try { localStorage.setItem('izigna-locale', loc); } catch(e){} }
        if (stored !== null) return;
        var nav = (navigator.language || navigator.userLanguage || '').slice(0, 2);
        if (nav === 'es' && loc !== 'es') {
          location.replace('/es' + location.pathname);
        }
      })();
    </script>
  </body>
</html>
