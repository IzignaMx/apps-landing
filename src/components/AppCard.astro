---
function hexToRgb(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return `${r}, ${g}, ${b}`;
}

interface Props {
  name: string;
  description: string;
  platform: string;
  status: 'active' | 'coming' | 'planned';
  accentColor: string;
  iconSvg?: string;
  href?: string;
  /** When true, opens href in a new tab (used for external install URLs). */
  external?: boolean;
  comingSoonLabel: string;
  installLabel?: string;
  activeLabel?: string;
}

const { name, description, platform, status, accentColor, iconSvg, href, external = false, comingSoonLabel, installLabel, activeLabel } = Astro.props;
const isActive = status === 'active';
const glowRgb = hexToRgb(accentColor);
const linkAttrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<div
  class:list={[
    'relative rounded-xl border bg-card overflow-hidden transition-all duration-300 group',
    isActive ? 'border-border-card' : 'border-border-card opacity-80',
  ]}
  style={`--service-color: ${accentColor}; --glow-rgb: ${glowRgb};`}
  data-active={isActive || undefined}
>
  <div class="accent-bar" style={`background: ${accentColor};`}></div>

  <div class="p-6 md:p-8">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-3">
        <div
          class="w-14 h-14 rounded-xl flex items-center justify-center border transition-colors duration-300"
          style={`background: #1e1e1e; border-color: ${accentColor}30;`}
        >
          {iconSvg ? (
            <Fragment set:html={iconSvg} />
          ) : (
            <svg class="w-6 h-6 text-text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          )}
        </div>
        <div>
          <h3 class="font-display text-xl font-bold">{name}</h3>
          <span class="text-xs font-mono text-text-muted">{platform}</span>
        </div>
      </div>

      {isActive ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-xs font-mono text-green-400">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
          {activeLabel || 'Active'}
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-text-muted/10 border border-text-muted/20 text-xs font-mono text-text-secondary">
          {comingSoonLabel}
        </span>
      )}
    </div>

    <p class="text-text-secondary text-sm leading-relaxed mb-6">{description}</p>

    {isActive ? (
      <a href={href || '#'} {...linkAttrs} class="btn-primary text-sm">
        {installLabel || 'Install'}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        {external && <span class="sr-only"> (opens in new window)</span>}
      </a>
    ) : (
      <div class="flex items-center gap-2 text-text-secondary text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {comingSoonLabel}
      </div>
    )}
  </div>
</div>

<style>
  div[data-active]:hover {
    box-shadow: 0 0 40px rgba(var(--glow-rgb), 0.15);
  }
</style>
