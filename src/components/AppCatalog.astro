---
import AppCard from './AppCard.astro';
import { type Locale, getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const apps = [
  {
    key: 'omnisync',
    name: t.apps.omnisync.name,
    description: t.apps.omnisync.shortDesc,
    platform: t.apps.omnisync.platform,
    status: t.apps.omnisync.status as 'active' | 'coming',
    accentColor: '#3b82f6',
    iconSvg: '<svg class="w-6 h-6" style="filter: brightness(0) invert(1) opacity(0.9);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>',
    href: '#omnisync',
  },
  {
    key: 'odoo-sync',
    name: t.apps['odoo-sync'].name,
    description: t.apps['odoo-sync'].shortDesc,
    platform: t.apps['odoo-sync'].platform,
    status: t.apps['odoo-sync'].status as 'active' | 'coming',
    accentColor: '#10b981',
    iconSvg: '<svg class="w-6 h-6" style="filter: brightness(0) invert(1) opacity(0.9);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>',
  },
  {
    key: 'bigcommerce-sync',
    name: t.apps['bigcommerce-sync'].name,
    description: t.apps['bigcommerce-sync'].shortDesc,
    platform: t.apps['bigcommerce-sync'].platform,
    status: t.apps['bigcommerce-sync'].status as 'active' | 'coming',
    accentColor: '#ef4444',
    iconSvg: '<svg class="w-6 h-6" style="filter: brightness(0) invert(1) opacity(0.9);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg>',
  },
  {
    key: 'wordpress-sync',
    name: t.apps['wordpress-sync'].name,
    description: t.apps['wordpress-sync'].shortDesc,
    platform: t.apps['wordpress-sync'].platform,
    status: t.apps['wordpress-sync'].status as 'active' | 'coming',
    accentColor: '#0284c7',
    iconSvg: '<svg class="w-6 h-6" style="filter: brightness(0) invert(1) opacity(0.9);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>',
  },
];
---

<section id="apps" class="py-16 md:py-24">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-4">
        {t.catalog.title}
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto">
        {t.catalog.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {apps.map((app) => (
        <AppCard
          name={app.name}
          description={app.description}
          platform={app.platform}
          status={app.status}
          accentColor={app.accentColor}
          iconSvg={app.iconSvg}
          href={app.href}
          comingSoonLabel={t.catalog.comingSoon}
          installLabel={t.featured.cta}
          activeLabel={app.key === 'omnisync' ? t.catalog.active : undefined}
        />
      ))}
    </div>
  </div>
</section>
