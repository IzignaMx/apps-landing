---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import FeaturedApp from '../../components/FeaturedApp.astro';
import AppCatalog from '../../components/AppCatalog.astro';
import TrustSection from '../../components/TrustSection.astro';
import Footer from '../../components/Footer.astro';
import type { Locale } from '../../i18n';

const locale: Locale = 'es';
---

<Layout locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <FeaturedApp locale={locale} />
    <AppCatalog locale={locale} />
    <TrustSection locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
