---
import AppCard from './AppCard.astro';
import { type Locale, getTranslations, getAppTranslation } from '../i18n';
import { APP_CATALOG } from '../data/apps';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

// Build the catalog view-models by merging the central catalog with the
// translation strings. Falling back to the catalog key if a translation
// entry is missing makes it safe to add new apps before all locales are
// translated.
const apps = APP_CATALOG.map((app) => {
  const tApp = getAppTranslation(t, app.translationKey);
  return {
    key: app.key,
    name: tApp?.name ?? app.key,
    description: tApp?.shortDesc ?? '',
    platform: app.platform,
    status: app.status,
    accentColor: app.accentHex,
    iconSvg: app.iconSvg,
    // When installUrl is set AND the app is active, the card links to it.
    // Otherwise we scroll to the anchor (e.g. #omnisync).
    href: app.status === 'active' && app.installUrl ? app.installUrl : `#${app.anchorId}`,
    featured: app.featured,
    installUrl: app.installUrl,
  };
});
---

<section id="apps" class="py-16 md:py-24">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-4">
        {t.catalog.title}
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto">
        {t.catalog.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {apps.map((app) => (
        <AppCard
          name={app.name}
          description={app.description}
          platform={app.platform}
          status={app.status}
          accentColor={app.accentColor}
          iconSvg={app.iconSvg}
          href={app.href}
          external={Boolean(app.installUrl && app.status === 'active')}
          comingSoonLabel={t.catalog.comingSoon}
          installLabel={t.featured.cta}
          activeLabel={app.status === 'active' ? t.catalog.active : undefined}
        />
      ))}
    </div>
  </div>
</section>
