---
import DocDetailPage from '../../../../components/DocDetailPage.astro';
import { getCollection } from 'astro:content';
import { type Locale } from '../../../../i18n';
import { getAppByKey } from '../../../../data/apps';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const paths: { params: { app: string; slug: string }; props: { entry: any; locale: Locale } }[] = [];

  for (const entry of docs) {
    const [appKey, ...slugParts] = entry.id.split('/');
    if (!appKey || slugParts.length === 0) continue;
    const slug = slugParts.join('/');
    if (!getAppByKey(appKey)) continue;

    paths.push({
      params: { app: appKey, slug },
      props: { entry, locale: 'es' as Locale },
    });
  }

  return paths;
}
---
<DocDetailPage {...Astro.props} />
