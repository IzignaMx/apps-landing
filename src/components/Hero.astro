---
import { type Locale, getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 dot-grid opacity-40 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 gradient-orb-blue pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 gradient-orb-purple pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-[1280px] mx-auto px-6 pt-24 pb-20 md:pt-32 md:pb-28 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-border-card bg-card/60 mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-izigna animate-pulse"></span>
      <span class="text-xs font-mono text-text-muted uppercase tracking-widest">{t.hero.overline}</span>
    </div>

    <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.1] mb-6">
      <span class="bg-gradient-to-r from-text-primary via-text-primary to-izigna bg-clip-text text-transparent">
        {t.hero.title}
      </span>
    </h1>

    <p class="max-w-2xl mx-auto text-lg md:text-xl text-text-secondary leading-relaxed mb-10">
      {t.hero.subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#apps" class="btn-primary text-base">
        {t.hero.cta}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </a>
      <a href="https://izignamx.com" target="_blank" rel="noopener noreferrer" class="btn-secondary text-base">
        {t.hero.ctaSecondary}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>
  </div>
</section>
