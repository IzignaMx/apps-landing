---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';
import { type Locale, getTranslations, localePath } from '../../../../i18n';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id.replace(/^omnisync\//, '') },
    props: { entry, locale: 'es' as Locale },
  }));
}

const { entry, locale } = Astro.props;
const { Content } = await render(entry);
const t = getTranslations(locale);

const allDocs = await getCollection('docs');
const sorted = allDocs
  .filter((d) => d.data.app === 'omnisync')
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = sorted.findIndex((d) => d.id === entry.id);
const prevDoc = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const nextDoc = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

const breadcrumbs = [
  { label: t.docs.title, href: localePath('/docs', locale) },
  { label: 'OmniSync', href: localePath('/docs/omnisync/getting-started', locale) },
  { label: t.docs.sections[entry.data.section] || entry.data.section },
];
---

<DocsLayout title={entry.data.title} description={entry.data.description} locale={locale} breadcrumbs={breadcrumbs}>
  <header class="mb-8 not-prose">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-mono text-izigna uppercase tracking-widest">{entry.data.app}</span>
      <span class="text-text-muted">&middot;</span>
      <span class="text-xs font-mono text-text-muted uppercase tracking-widest">{entry.data.section}</span>
    </div>
    <h1 class="font-display text-3xl md:text-4xl font-black tracking-tight">{entry.data.title}</h1>
    <p class="text-text-secondary mt-2">{entry.data.description}</p>
    {entry.data.updated && (
      <p class="text-xs text-text-muted mt-3 font-mono">
        {t.docs.lastUpdated}: {entry.data.updated.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    )}
  </header>
  <Content />

  {(prevDoc || nextDoc) && (
    <nav class="not-prose mt-12 pt-6 border-t border-border-card flex items-center justify-between gap-4" aria-label="Doc navigation">
      {prevDoc ? (
        <a
          href={localePath(`/docs/${prevDoc.id}`, locale)}
          class="group flex flex-col items-start text-left p-3 -ml-3 rounded-lg hover:bg-card transition-colors max-w-[45%]"
        >
          <span class="text-xs text-text-muted mb-1">{t.docs.previous}</span>
          <span class="text-sm font-semibold text-text-primary group-hover:text-izigna transition-colors">
            &larr; {prevDoc.data.title}
          </span>
        </a>
      ) : <div />}
      {nextDoc ? (
        <a
          href={localePath(`/docs/${nextDoc.id}`, locale)}
          class="group flex flex-col items-end text-right p-3 -mr-3 rounded-lg hover:bg-card transition-colors max-w-[45%]"
        >
          <span class="text-xs text-text-muted mb-1">{t.docs.next}</span>
          <span class="text-sm font-semibold text-text-primary group-hover:text-izigna transition-colors">
            {nextDoc.data.title} &rarr;
          </span>
        </a>
      ) : <div />}
    </nav>
  )}
</DocsLayout>
